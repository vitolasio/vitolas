{%- comment -%}
  Calimia SEO Desk: structured data, a one-time theme change that replaces TinySEO's JSON-LD.

  Install (on a DUPLICATE of the live theme first, then publish it):
    1. Online Store > Themes > ... > Duplicate. On the copy: Edit code > Snippets > Add a new snippet
       named calimia-structured-data, and paste this file.
    2. In layout/theme.liquid, just before </head>, add:
         {% render 'calimia-structured-data' %}
       To also emit Product data (only if the theme does not already), use:
         {% render 'calimia-structured-data', include_product: true %}
    3. Turn TinySEO's JSON-LD off, preview the copy, and check a product page in
       https://search.google.com/test/rich-results : exactly one Product, one BreadcrumbList
       and one store entity. Then publish the copy.
{%- endcomment -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeGoodsStore",
    "@id": {{ shop.url | append: '/#store' | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
    {%- if shop.phone != blank -%}, "telephone": {{ shop.phone | json }}{%- endif -%}
    {%- if shop.address.address1 != blank -%},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ shop.address.address1 | append: ' ' | append: shop.address.address2 | strip | json }},
      "addressLocality": {{ shop.address.city | json }},
      "addressRegion": {{ shop.address.province_code | json }},
      "postalCode": {{ shop.address.zip | json }},
      "addressCountry": {{ shop.address.country_code | json }}
    }
    {%- endif -%}
  }
</script>

{%- if template.name == 'product' -%}
  {%- assign crumb_collection = collection | default: product.collections.first -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
        {%- if crumb_collection -%},
        { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- else -%},
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
  {%- if include_product -%}
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  {%- endif -%}
{%- elsif template.name == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
      ]
    }
  </script>
{%- endif -%}
